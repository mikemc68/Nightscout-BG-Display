const float MGDL_PER_MMOL = 18.0f;

// Thresholds in mmol/L. Defaults = Nightscout defaults; replaced by your site's settings.
float thUrgLow = 55 / MGDL_PER_MMOL, thLow = 80 / MGDL_PER_MMOL;
float thHigh = 180 / MGDL_PER_MMOL, thUrgHigh = 260 / MGDL_PER_MMOL;

