#define COL(r, g, b) ((uint16_t)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))
const uint16_t C_BLACK = 0x0000;
const uint16_t C_OK    = COL(0x5D, 0xCA, 0xA5);  // in range
const uint16_t C_WARN  = COL(0xEF, 0x9F, 0x27);  // out of target
const uint16_t C_URG   = COL(0xF2, 0x5C, 0x5C);  // urgent
const uint16_t C_GREY  = COL(0x60, 0x60, 0x60);  // stale
